{
    "name": "inver/my-theme",
    "type": "wordpress-theme",
    "description": "Стартовый шаблон WordPress. Стек: PHP 8.2+, CSS Custom Properties + BEM, Vanilla JS ES6+, ACF Pro ready.",
    "keywords": ["WordPress", "Theme"],
    "homepage": "https://example.com/",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Inver",
            "homepage": "https://example.com/"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "wptrt/wpthemereview": "^0.2.1",
        "php-parallel-lint/php-parallel-lint": "^1.3.0",
        "wp-cli/i18n-command": "^2.3.0"
    },
    "scripts": {
        "lint:wpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
        "make-pot": "wp i18n make-pot . languages/wp-frame.pot"
    },
    "support": {
        "issues": "https://example.com/"
    }
}
